# Copie para .env.local e preencha. NUNCA commite valores reais.
# Detalhes de cada variável: README.md → "Variáveis de ambiente".

# Banco (Neon) — app usa um papel restrito (host -pooler); migrações usam o dono (conexão direta)
DATABASE_URL=postgresql://PAPEL_DO_APP:SENHA@HOST-pooler.REGIAO.aws.neon.tech/BANCO?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://PAPEL_DONO:SENHA@HOST.REGIAO.aws.neon.tech/BANCO?sslmode=require

# Autenticação (Better Auth)
BETTER_AUTH_SECRET=gere-com-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:5173

# Google OAuth (cliente "EngCalc Web")
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# Primeiro(s) admin(s) — usado por `npm run db:seed-admin`
ADMIN_EMAILS=voce@gmail.com
