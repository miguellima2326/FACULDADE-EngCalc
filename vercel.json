{
  "buildCommand": "npm run build",
  "outputDirectory": "apps/frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?__path=$1"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "apps/backend/dist/**"
    }
  },
  "regions": [
    "gru1"
  ]
}
