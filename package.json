{
  "name": "engcalc",
  "private": true,
  "version": "3.0.0-migration",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "npm --workspace apps/frontend run dev",
    "dev:backend": "npm --workspace apps/backend run dev",
    "build": "npm run build:core && npm run build:backend && npm run build:frontend",
    "build:core": "npm --workspace packages/core run build",
    "build:backend": "npm --workspace apps/backend run build",
    "build:frontend": "npm --workspace apps/frontend run build",
    "test": "tsx --test packages/core/test/",
    "db:migrate": "npm --workspace apps/backend run db:migrate",
    "db:seed-admin": "npm --workspace apps/backend run db:seed-admin"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9"
  },
  "type": "module"
}
